    "signOut.pendinghighlights.explanation" : {
      "comment" : "Alert body warning unsaved highlights will be lost if user signs out while offline changes are pending.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Some of your highlights haven't been saved yet, and they will be lost if you sign out. Do you want to sign out anyway?"
          }
        },
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sommige van jou hoogtepunte is nog nie gestoor nie, en hulle sal verlore gaan as jy uitmelú. Wil jy nogsteeds uitmeld?"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يتم حفظ بعض تمييزاتك بعد، وستُفقد إذا قمت بتسجيل الخروج. هل تريد تسجيل الخروج على أي حال؟"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的一些高亮内容尚未保存，如果你退出登录，这些内容将会丢失。你确定要退出吗？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你有部分醒目標示尚未儲存，如果你登出，這些內容將會遺失。你確定要登出嗎？"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你部分的重點標記尚未儲存，如果你登出，這些標記將會遺失。你確定仍要登出嗎？"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Některá vaše zvýraznění ještě nebyla uložena a, pokud se nyní odhlásíte, budou ztracena. Chcete se přesto odhlásit?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sommige van je markeringen zijn nog niet opgeslagen en gaan verloren als je uitlogt. Wil je toch uitloggen?"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Joitakin korostuksiasi ei ole vielä tallennettu, ja ne menetetään, jos kirjaudut ulos. Haluatko kirjautua ulos silti?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Certains de tes surlignages n’ont pas encore été enregistrés et seront perdus si tu te déconnectes. Veux-tu quand même te déconnecter ?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einige deiner Markierungen wurden noch nicht gespeichert und gehen verloren, wenn du dich abmeldest. Möchtest du dich trotzdem abmelden?"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Néhány kiemelésed még nem lett elmentve, és elvesznek, ha kijelentkezel. Biztosan ki szeretnél jelentkezni?"
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Echekwabèghị ụfọdụ ihe ndị ị merè ka ha pụta ìhè, ma ha gá-efù ma ị pụọ. Ị̀ chọrọ̀ ịpụ n'agbanyèghị?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alcune delle tue evidenziazioni non sono ancora state salvate e andranno perse se ti disconnetti. Vuoi disconnetterti comunque?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ハイライトの一部がまだ保存されていません。サインアウトすると失われます。それでもサインアウトしますか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일부 하이라이트가 아직 저장되지 않았으며, 로그아웃하면 삭제됩니다. 그래도 로그아웃하시겠습니까?"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du har markeringer som ikke er lagret ennå. De vil gå tapt hvis du logger ut. Vil du logge ut likevel?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_translation",
            "value" : ""
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alguns dos seus destaques ainda não foram guardados e serão perdidos se terminar a sessão. Deseja terminar a sessão mesmo assim?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alguns dos seus destaques ainda não foram salvos e serão perdidos se você sair. Deseja sair mesmo assim?"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unele dintre evidențierile tale nu au fost salvate încă și se vor pierde dacă te deconectezi. Vrei să te deconectezi oricum?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Некоторые из ваших маркеров ещё не сохранены и будут потеряны, если вы выйдете из системы. Вы всё равно хотите выйти?"
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neki od vaših istaknutih odlomaka još nisu sačuvani i biće izgubljeni ako se odjavite. Da li ipak želite da se odjavite?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algunos de tus destacados aún no se han guardado y se perderán si cierras sesión. ¿Deseas cerrar sesión de todos modos?"
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algunos de tus resaltados no se han guardado aún y se perderán si cierras sesión. ¿Deseas cerrar sesión de todas formas?"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Några av dina markeringar har inte sparats än och de kommer att gå förlorade om du loggar ut. Vill du logga ut ändå?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bazı vurgularınız henüz kaydedilmedi ve oturumu kapatırsanız kaybolacaklar. Yine de oturumu kapatmak istiyor musunuz?"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Деякі ваші позначення ще не збережено, і вони будуть втрачені, якщо ви вийдете з облікового запису. Ви все одно хочете вийти?"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một số điểm nổi bật của bạn chưa được lưu và sẽ bị mất nếu bạn đăng xuất. Bạn có muốn đăng xuất không?"
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nid yw rhai o'th amlygiadau wedi'u cadw eto, a byddan nhw'n cael eu colli os byddi di'n allgofnodi. Wyt ti am allgofnodi beth bynnag?"
          }
        }
      }
    },
