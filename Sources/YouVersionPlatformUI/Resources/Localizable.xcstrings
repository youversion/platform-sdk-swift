    "download.callToAction": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lies sie jederzeit, überall – sogar offline"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read it anytime, anywhere—even offline"
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Léela cuando quieras, donde quieras, incluso sin conexión"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lis-la à tout moment, n'importe où, même hors ligne"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Lees dit enige tyd, enige plek – selfs vanlyn"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اقرأه في أي وقت وفي أي مكان—حتى دون اتصال"
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Darllena unrhyw bryd, unrhyw le—hyd yn oed all-lein"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Léela en cualquier momento y lugar, incluso sin conexión"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Olvasd bármikor, bárhol – akár offline is"
          }
        },
        "ig": {
          "stringUnit": {
            "state": "translated",
            "value": "Gụọ ya oge ọbụla, ebe ọbụla—ọbụlagodi n'enweghị ịntanetị"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "언제 어디서든 읽으세요. 오프라인에서도 읽을 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Leia a qualquer hora, em qualquer lugar — mesmo off-line"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Читайте в любое время и в любом месте — даже без интернета"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Läs den när som helst, var som helst – även offline"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İstediğiniz zaman, istediğiniz yerde —çevrimdışı bile olsa— okuyun"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đọc bất cứ lúc nào, bất cứ nơi đâu—kể cả ngoại tuyến"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "随时随地阅读——即使离线也可以"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "隨時隨地閱讀——即使離線也可以"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "隨時隨地閱讀——即使離線也可以"
          }
