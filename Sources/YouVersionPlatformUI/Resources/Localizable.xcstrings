    "reader.availableLanguagesErrorBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It was not possible to get the list of available languages. Please try again later."
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Die lys van beskikbare tale kon nie verkry word nie. Probeer asseblief later weer."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر الحصول على قائمة اللغات المتاحة. يرجى المحاولة مرة أخرى لاحقاً."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Nid oedd modd cael rhestr o'r ieithoedd sydd ar gael. Rho gynnig arall arni yn nes ymlaen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es war nicht möglich, die Liste der verfügbaren Sprachen abzurufen. Bitte versuche es später erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No fue posible obtener la lista de idiomas disponibles. Por favor, inténtalo de nuevo más tarde."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "No fue posible obtener la lista de idiomas disponibles. Por favor intenta de nuevo más tarde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il n'a pas été possible d'obtenir la liste des langues disponibles. Veuillez réessayer plus tard."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem sikerült lekérni az elérhető nyelvek listáját. Kérjük, próbáld újra később."
          }
        },
        "ig": {
          "stringUnit": {
            "state": "translated",
            "value": "Ò kweghị omume ịnweta ndepụta asụsụ ndị dị adị. Biko nwaa ọzọ n'oge n'adịghị anya."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용 가능한 언어 목록을 가져올 수 없습니다. 나중에 다시 시도하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
