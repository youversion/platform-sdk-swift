          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma versão da Bíblia está disponível. Restabeleça a ligação e descarregue uma versão da Bíblia para continuar offline."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "利用可能な聖書の訳がありません。再接続して聖書の訳をダウンロードし、オフラインで使用してください。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu sunt disponibile versiuni ale Bibliei. Reconectează-te și descarcă o versiune a Bibliei pentru a continua în mod deconectat."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem érhető el Bibliafordítás. Csatlakozz újra a hálózathoz, és tölts le egy Bibliafordítást az offline használathoz."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_translation",
            "value": ""
          }
        }
      },
      "comment": "Empty state when no Bible versions are available offline."
    },
    "reader.versionAccessErrorBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It was not possible to access this Bible version. Please try again later."
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Toegang tot hierdie Bybelweergawe was nie moontlik nie. Probeer asseblief later weer."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يكن بالإمكان الوصول إلى هذا ألإصدار من الكتاب المقدس. يرجى المحاولة مرة أخرى لاحقاً."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Nid oedd modd cyrchu'r fersiwn Beibl hwn. Rho gynnig arall arni yn nes ymlaen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es war nicht möglich, auf diese Bibelversion zuzugreifen. Bitte versuche es später erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No fue posible acceder a esta versión de la Biblia. Por favor, inténtalo de nuevo más tarde."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "No fue posible acceder a esta versión de la Biblia. Por favor intenta de nuevo más tarde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il n'a pas été possible d'accéder à cette version de la Bible. Veuillez réessayer plus tard."
          }
        },
        "ig": {
          "stringUnit": {
            "state": "translated",
            "value": "Ò kweghị omume ịnweta ụdị-nsụgharị Akwụkwọ Nsọ a. Biko nwaa ọzọ n'oge n'adịghị anya."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "해당 성경 번역본에 접근할 수 없습니다. 나중에 다시 시도하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível acessar esta versão da Bíblia. Tente novamente mais tarde."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось получить доступ к этому переводу Библии. Пожалуйста, повторите попытку позже."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det gick inte att visa denna bibelöversättning. Försök igen senare."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Kutsal Kitap sürümüne erişilemedi. Lütfen daha sonra tekrar deneyin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể truy cập phiên bản Kinh Thánh này. Vui lòng thử lại sau."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法访问此圣经译本。请稍后再试。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "無法存取此聖經譯本。請稍後再試。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法存取此聖經譯本。請稍後再試。"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nebylo možné získat přístup k této verzi Bible. Zkuste to prosím znovu později."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tähän Raamatun versioon ei voitu päästä. Yritä myöhemmin uudelleen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile accedere a questa versione della Bibbia. Riprova più tardi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het was niet mogelijk om toegang te krijgen tot deze Bijbelvertaling. Probeer het later opnieuw."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det var ikke mulig å få tilgang til denne bibelutgaven. Prøv igjen senere."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Nije bilo moguće pristupiti ovom prevodu Biblije. Pokušajte ponovo kasnije."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося отримати доступ до цього перекладу Біблії. Будь ласка, спробуйте пізніше."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível aceder a esta versão da Bíblia. Por favor, tente novamente mais tarde."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この聖書の訳にアクセスできませんでした。後でもう一度お試しください。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu a fost posibil accesul la această versiune a Bibliei. Te rugăm să încerci din nou mai târziu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezt a Bibliafordítást nem sikerült elérni. Kérjük, próbáld újra később."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_translation",
            "value": ""
          }
        }
      },
      "comment": "Error body when selected Bible version cannot be accessed."
    },
