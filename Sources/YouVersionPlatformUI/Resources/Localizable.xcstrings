        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Prihvatite i preuzmite"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Погодитися та завантажити"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Concordar e Descarregar"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同意してダウンロード"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acceptați și descărcați"
          }
        },
        "pl": {
