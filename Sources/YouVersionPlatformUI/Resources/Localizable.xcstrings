    "reader.noVersionsAvailable": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Bibelversionen verfügbar. Stelle eine Verbindung her und lade eine Bibelversion herunter, um offline fortzufahren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No Bible versions are available. Re-connect and download a Bible version to proceed offline."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay versiones de la Biblia disponibles. Vuelve a conectarte y descarga una versión de la Biblia para continuar sin conexión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune version de la Bible n'est disponible. Reconnectez-vous et téléchargez une version de la Bible pour continuer hors ligne."
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen Bybelweergawes is beskikbaar nie. Herstel jou verbinding en laai 'n Bybelweergawe af om vanlyn voort te gaan."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تتوفر أي إصدارات للكتاب المقدس. أعد الاتصال وقم بتنزيل إصدار من الكتاب المقدس للمتابعة دون اتصال بالإنترنت."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Nid oes fersiynau o'r Beibl ar gael. Ailgysyllta a lawrlwytha fersiwn o'r Beibl i barhau all-lein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay versiones de la Biblia disponibles. Vuelve a conectarte y descarga una versión de la Biblia para continuar sin conexión."
          }
        },
        "ig": {
          "stringUnit": {
            "state": "translated",
            "value": "Ènweghị ụdị-nsụgharị-gasị Akwụkwọ Nsọ ọbụla dịnụ. Jikọọ ọzọ ma budata ụdị nsụgharị Akwụkwọ Nsọ ka ị gaa n'ihu n'ejighị ịntanetị."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용 가능한 성경 번역본이 없습니다. 다시 연결하고 성경 번역본을 다운로드하여 오프라인으로 진행하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma versão da Bíblia está disponível. Reconecte-se e baixe uma versão da Bíblia para continuar off-line."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переводы Библии недоступны. Подключитесь к сети и загрузите перевод Библии для работы в офлайн-режиме."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det finns inga bibelöversättningar tillgängliga. Anslut igen och ladda ner en bibelöversättning för att kunna fortsätta offline."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiçbir Kutsal Kitap çeviri versiyonu mevcut değil. Çevrimdışı devam etmek için yeniden bağlanın ve bir Kutsal Kitap versiyonu indirin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có phiên bản Kinh Thánh nào. Kết nối lại và tải xuống một phiên bản Kinh Thánh để tiếp tục ngoại tuyến."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有可用的圣经译本。请重新连接并下载一个圣经译本以便离线使用。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
