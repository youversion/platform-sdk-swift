    "dataExchange.highlights.explanation" : {
      "comment" : "Alert body explaining that YouVersion will request access before highlights can be saved.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "YouVersion will ask you to grant access before highlights can be saved."
          }
        },
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "YouVersion sal jou vra om toegang te verleen voordat hoogtepunte gestoor kan word."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيطلب منك YouVersion منح الوصول قبل حفظ التمييزات."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "YouVersion 将在保存高亮内容之前请求你授予访问权限。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "YouVersion 將在儲存醒目標示前要求你授予存取權限。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "YouVersion 將在儲存重點標記前要求你授予存取權限。"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Než budou zvýraznění uložena, YouVersion vás požádá o udělení přístupu."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "YouVersion zal je vragen om toegang te verlenen voordat markeringen kunnen worden opgeslagen."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "YouVersion pyytää sinulta käyttöoikeutta ennen kuin korostukset voidaan tallentaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "YouVersion vous demandera d'accorder l'accès avant que les surlignages puissent être enregistrés."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "YouVersion wird dich um Zugriff bitten, bevor Markierungen gespeichert werden können."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A YouVersion hozzáférést fog kérni, mielőtt a kiemelések menthetők lennének."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "YouVersion gà-àrịọ́ gị ka ị nye ohere tupu enwee ike ichekwa ihe ndị emerè ka ha pụta ìhè."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "YouVersion ti chiederà di concedere l'accesso prima che le evidenziazioni possano essere salvate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ハイライトを保存する前に、YouVersionがアクセス許可を求めます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "하이라이트를 저장하기 전에 YouVersion에서 액세스 권한을 요청합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "YouVersion ber deg om å gi tilgang før markeringene kan lagres."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_translation",
            "value" : ""
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A YouVersion irá pedir-lhe que conceda acesso antes de os destaques poderem ser guardados."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O YouVersion solicitará que você conceda acesso antes que os destaques possam ser salvos."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "YouVersion vă va cere să acordați acces înainte ca evidențierile să poată fi salvate."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перед сохранением маркеров YouVersion запросит у вас разрешение на доступ."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "YouVersion će od vas tražiti da odobrite pristup pre nego što se isticanja mogu sačuvati."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "YouVersion te pedirá que concedas acceso antes de que se puedan guardar los destacados."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "YouVersion te pedirá que otorgues acceso antes de que se puedan guardar los resaltados."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "YouVersion kommer att be dig bevilja åtkomst innan markeringar kan sparas."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "YouVersion, vurgular kaydedilmeden önce erişim izni vermenizi isteyecektir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "YouVersion попросить вас надати доступ, перш ніж позначення можна буде зберегти."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "YouVersion sẽ yêu cầu bạn cấp quyền truy cập trước khi có thể lưu các phần đánh dấu."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bydd YouVersion yn gofyn i ti ganiatáu mynediad cyn y gellir cadw amlygiadau."
          }
        }
      }
    },
