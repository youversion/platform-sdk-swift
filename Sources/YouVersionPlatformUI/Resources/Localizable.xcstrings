    "reader.versionAccessErrorBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It was not possible to access this Bible version. Please try again later."
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Toegang tot hierdie Bybelweergawe was nie moontlik nie. Probeer asseblief later weer."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يكن بالإمكان الوصول إلى هذا ألإصدار من الكتاب المقدس. يرجى المحاولة مرة أخرى لاحقاً."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Nid oedd modd cyrchu'r fersiwn Beibl hwn. Rho gynnig arall arni yn nes ymlaen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es war nicht möglich, auf diese Bibelversion zuzugreifen. Bitte versuche es später erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No fue posible acceder a esta versión de la Biblia. Por favor, inténtalo de nuevo más tarde."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "No fue posible acceder a esta versión de la Biblia. Por favor intenta de nuevo más tarde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il n'a pas été possible d'accéder à cette version de la Bible. Veuillez réessayer plus tard."
          }
        },
        "ig": {
          "stringUnit": {
            "state": "translated",
            "value": "Ò kweghị omume ịnweta ụdị-nsụgharị Akwụkwọ Nsọ a. Biko nwaa ọzọ n'oge n'adịghị anya."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "해당 성경 번역본에 접근할 수 없습니다. 나중에 다시 시도하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível acessar esta versão da Bíblia. Tente novamente mais tarde."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось получить доступ к этому переводу Библии. Пожалуйста, повторите попытку позже."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det gick inte att visa denna bibelöversättning. Försök igen senare."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Kutsal Kitap sürümüne erişilemedi. Lütfen daha sonra tekrar deneyin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể truy cập phiên bản Kinh Thánh này. Vui lòng thử lại sau."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法访问此圣经译本。请稍后再试。"
          }
        },
        "zh-HK": {
