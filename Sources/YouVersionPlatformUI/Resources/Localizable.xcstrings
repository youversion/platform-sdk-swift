    "signOut.explanation" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du musst dich erneut anmelden, um auf deine Markierungen zuzugreifen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You'll need to sign in again to access your highlights."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deberás iniciar sesión nuevamente para acceder a tus resaltados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous devrez vous reconnecter pour accéder à vos surlignages."
          }
        },
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jy sal weer moet aanteken om toegang tot jou kleurmerke te kry."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستحتاج إلى تسجيل الدخول مرة أخرى للوصول إلى النصوص الخاصة بك."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bydd angen i ti fewngofnodi eto i gael mynediad at dy uchafbwyntiau."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deberás iniciar sesión nuevamente para acceder a tus destacados."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Újra be kell jelentkezned a kiemeléseid eléréséhez."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ọ dị mkpa ka ị bànyé ọzọ iji nweta ihe gị ndị ị merè ka ha pụta ìhè."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "하이라이트에 접근하려면 다시 로그인해야 합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você precisará entrar novamente para acessar os destaques."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вам нужно будет заново авторизоваться, чтобы получить доступ к своим маркерам."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du måste logga in igen för att komma åt dina markeringar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vurgularınıza erişmek için tekrar giriş yapmanız gerekecek."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn cần đăng nhập lại để truy cập các phần đánh dấu của mình."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你需要重新登录才能访问你的高亮内容。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你需要重新登入才能存取你的亮點記錄。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你需要重新登入才能查看你的醒目標示。"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pro přístup ke svým zvýrazněním se budete muset znovu přihlásit."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sinun täytyy kirjautua sisään uudelleen päästäksesi korostuksiisi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dovrai accedere di nuovo per visualizzare le tue evidenziazioni."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je moet je opnieuw aanmelden om je markeringen te kunnen bekijken."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du må logge inn igjen for å få tilgang til markeringene dine."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moraćete da se prijavite ponovo da biste pristupili svojim isticanjima."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вам потрібно буде увійти знову, щоб отримати доступ до своїх позначень."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terá de iniciar sessão novamente para aceder aos seus destaques."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ハイライトにアクセスするには、再度サインインする必要があります。"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Va trebui să te conectezi din nou pentru a accesa evidențierile tale."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_translation",
            "value" : ""
          }
        }
      },
      "comment" : "Supplementary sign-out explanation about highlights access."
    },
