    "signIn.paragraph": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ möchte sich mit deinem YouVersion Bible App-Konto verbinden. Dies ermöglicht ihnen, deine Bibel-App-Aktivitäten zu sehen und damit zu interagieren. Möchtest du fortfahren?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wants to connect to your YouVersion Bible App account. This will allow them to see and interact with your Bible App activity. Would you like to proceed?"
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ quiere conectarse a tu cuenta de YouVersion Bible App. Esto les permitirá ver e interactuar con tu actividad en la aplicación. ¿Te gustaría continuar?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ souhaite se connecter à ton compte YouVersion Bible App. Cela lui permettra de voir et d'interagir avec ton activité dans l'application. Souhaites-tu continuer ?"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ versoek toegang tot jou YouVersion Bybeltoep-rekening. Dit sal hulle toelaat om jou aktiwiteit in die Bybeltoep te volg en die inligting te gebruik. Wil jy voortgaan?"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ يريد الاتصال بحساب تطبيق الكتاب المقدس YouVersion الخاص بك. سيتيح لهم ذلك رؤية نشاطك في تطبيق الكتاب المقدس والتفاعل معه. هل تريد المتابعة؟"
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Mae%@ am gysylltu â'th gyfrif Ap Beibl YouVersion. Bydd hyn yn caniatáu iddyn nhw weld a rhyngweithio â'th weithgaredd Ap Beibl. Hoffet ti barhau?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Quiere conectarse a tu cuenta de la aplicación Biblia de YouVersion. Esto les permitirá ver e interactuar con tu actividad en la aplicación Biblia. ¿Te gustaría continuar?"
          }
        },
        "ig": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ chọrọ ijikọ na akaụntụ Ngwá Baịbụl YouVersion gị. Nke a gà-ènyé ha ohere ịhụ ma sòró ihe omume Ngwá Baịbụl gị ná-èmekọrịtá ihe. Ị̀ gà-àchọ́ ịga n'ihu?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 서비스가 YouVersion 성경 앱 계정에 연결하려고 합니다. 연결하면 해당 서비스가 회원님의 성경 앱 활동을 확인하고 상호작용할 수 있습니다. 계속하시겠습니까?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ quer se conectar à sua conta do App da Bíblia da YouVersion. Isso permitirá que eles vejam e interajam com sua atividade no App da Bíblia. Deseja prosseguir?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ хочет подключиться к вашей учетной записи приложения Библия YouVersion. Это позволит им видеть вашу активность в приложении Библия и взаимодействовать с ней. Хотите продолжить?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ vill ansluta till ditt konto i YouVersion bibelappen. Detta gör det möjligt för dem att se och vara delaktiga i din aktivitet i bibelappen. Vill du fortsätta?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, YouVersion Kutsal Kitap uygulaması hesabınıza bağlanmak istiyor. Bu, uygulama etkinliğinizi görmelerine ve etkileşime girmelerine olanak tanıyacak. Devam etmek ister misiniz?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ muốn kết nối với tài khoản Ứng dụng Kinh Thánh YouVersion của bạn. Điều này sẽ cho phép họ xem và tương tác với hoạt động Ứng dụng Kinh Thánh của bạn. Bạn có muốn tiếp tục không?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 想与你的 YouVersion 圣经软件账户连接。这将允许他们查看你的圣经软件活动并与之互动。你是否愿意继续？"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 想要連接你的 YouVersion 聖經軟件帳戶。這將允許他們查看你的聖經軟件活動並與之互動。你是否想繼續嗎？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 想與你的 YouVersion 聖經軟體帳戶連接。這將允許他們查看你的聖經軟體活動並與之互動。你要繼續嗎？"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_translation",
            "value": ""
          }
        },
