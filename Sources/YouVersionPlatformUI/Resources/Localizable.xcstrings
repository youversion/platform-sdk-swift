    "offlineDownloadAgreement" : {
      "comment" : "Publisher consent text shown before offline Bible version download.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Our agreement with the publisher of this Bible version requires us to share certain information with them in order to offer this version for offline use. By proceeding you agree to share your information and to allow the publisher to email you."
          }
        },
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ons ooreenkoms met die uitgewer van hierdie Bybelweergawe vereis dat ons sekere inligting aan hulle bekend maak om hierdie weergawe vir vanlyn gebruik beskikbaar te stel. Deur voort te gaan, stem jy in om jou inligting toeganklik te maak en dat die uitgewer jou per e-pos mag kontak."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتطلب اتفاقيتنا مع ناشر هذا الإصدار من الكتاب المقدس مشاركة معلومات معينة معهم لتقديم هذا الإصدار للاستخدام دون اتصال. بالمتابعة، توافق على مشاركة معلوماتك والسماح للناشر بمراسلتك عبر البريد الإلكتروني."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我们与此圣经译本出版机构的协议要求我们与其共享某些信息，以便提供此译本的离线使用。继续操作即表示你同意共享你的信息，并允许出版机构向你发送电子邮件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我們與此聖經譯本出版機構的協議要求我們與其分享某些資訊，以便提供此譯本的離線使用。繼續操作即表示你同意分享你的資訊，並允許出版機構向你發送電子郵件。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我們與此聖經譯本出版商的協議要求我們與其分享某些資訊，以便提供此譯本供離線使用。繼續即表示你同意分享你的資訊，並允許出版商向你發送電子郵件。"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naše dohoda s vydavatelem této verze Bible nás zavazuje sdílet určité informace s nimi, abychom mohli nabídnout tuto verzi pro offline použití. Pokračováním souhlasíte se sdílením vašich informací a s tím, že vám vydavatel může zasílat emaily."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onze overeenkomst met de uitgever van deze Bijbelvertaling houdt in dat we bepaalde gegevens met hen moeten delen om deze vertaling offline beschikbaar te kunnen maken. Als je doorgaat, ga je ermee akkoord dat je gegevens worden gedeeld en dat de uitgever je e-mails mag sturen."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sopimuksemme tämän Raamatun version julkaisijan kanssa edellyttää, että jaamme tiettyjä tietoja heidän kanssaan tarjotaksemme tämän version offline-käyttöön. Jatkamalla hyväksyt tietojesi jakamisen ja sallit julkaisijan lähettää sinulle sähköpostia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notre accord avec l'éditeur de cette version de la Bible nous oblige à partager certaines informations avec eux afin de proposer cette version pour une utilisation hors ligne. En continuant, vous acceptez de partager vos informations et d'autoriser l'éditeur à vous envoyer des e-mails."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unsere Vereinbarung mit dem Herausgeber dieser Bibelausgabe erfordert, dass wir bestimmte Informationen an ihn weitergeben, um diese Ausgabe für die Offline-Nutzung anbieten zu können. Wenn du fortfährst, erklärst du dich damit einverstanden, deine Daten weiterzugeben und dem Herausgeber zu gestatten, dir E-Mails zu senden."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Bibliafordítás kiadójával kötött megállapodásunk értelmében bizonyos adatokat meg kell osztanunk velük ahhoz, hogy ezt a verziót offline használatra is elérhetővé tegyük. A folytatással hozzájárulsz adataid megosztásához, és ahhoz, hogy a kiadó e-mailt küldhessen neked."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nkwekọrịta anyị na onye bipụtara ụdị-nsụgharị Akwụkwọ Nsọ a chọrọ ka anyị kekọrịtara ha ụfọdụ ozi iji nye gị ụdị-nsụgharị a maka iji ya wee ihe na offlaịnụ. Site n'ịga n'ihu ị kwenyerè ịkekọrịtà ozi gị na ikwe ka onye mbipụta zitere gị ịmel."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il nostro accordo con l'editore di questa versione della Bibbia ci richiede di condividere determinate informazioni con loro per offrire questa versione per l'uso offline. Procedendo, accetti di condividere le tue informazioni e di consentire all'editore di inviarti email."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この聖書の訳の出版社との契約により、オフラインで使用するためには特定の情報を共有する必要があります。続行することで、情報の共有と出版社からのメール受信に同意したことになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오프라인 사용을 위해서는 성경 번역본 출판사와의 계약에 따라 특정 정보를 공유해야 합니다. 계속 진행하시면 귀하의 정보를 공유하고 출판사가 이메일을 보낼 수 있도록 동의하는 것으로 간주됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avtalen vår med utgiveren av denne bibelutgaven krever at vi deler spesifikk informasjon med dem for å kunne tilby denne utgaven for bruk uten nett. Ved å fortsette samtykker du i å dele informasjonen din og tillate utgiveren å sende deg e-post."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_translation",
            "value" : ""
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O nosso acordo com o editor desta versão da Bíblia exige que partilhemos com ele certas informações para oferecer esta versão para uso offline. Ao prosseguir, concorda em partilhar as suas informações e que o editor lhe envie e-mails."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nosso acordo com o editor desta versão da Bíblia nos exige compartilhar certas informações com eles para oferecer esta versão para uso offl-ine. Ao prosseguir, você concorda em compartilhar suas informações e permitir que o editor lhe envie e-mails."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acordul nostru cu editorul acestei versiuni a Bibliei ne obligă să împărtășim anumite informații cu aceștia pentru a oferi această versiune pentru utilizare în mod deconectat. Continuând, ești de acord să împărtășești aceste informații și să permiți editorului să îți trimită e-mailuri."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Наше соглашение с издателем этого перевода Библии требует, чтобы мы передали им определённую информацию для предоставления этого перевода для использования в офлайн-режиме. Продолжая, вы соглашаетесь передать свои данные и разрешить издателю отправлять вам электронные письма."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naš sporazum s izdavačem ovog prevoda Biblije zahteva da delimo određene informacije sa njima kako bismo ponudili ovaj prevod za korišćenje van mreže. Nastavljajući, pristajete na deljenje vaših informacija i dozvoljavate izdavaču da vam šalje imejl."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nuestro acuerdo con el editor de esta versión de la Biblia nos exige compartir cierta información con ellos para poder ofrecer esta versión para uso sin conexión. Al continuar, aceptas compartir tu información y permitir que el editor te envíe correos electrónicos."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nuestro acuerdo con el editor de esta versión de la Biblia nos exige compartir cierta información con ellos para poder ofrecer esta versión para uso sin conexión. Al continuar, aceptas compartir tu información y permitir que el editor te envíe correos electrónicos."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enligt vårt avtal med utgivaren av denna bibelöversättning är vi skyldiga att dela viss information med dem för att kunna erbjuda denna översättning för användning offline. Genom att fortsätta samtycker du till att dela dina uppgifter och till att utgivaren får skicka e-post till dig."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu Kutsal Kitap çeviri versiyonunun yayıncısıyla yaptığımız anlaşma, bu sürümü çevrimdışı kullanım için sunabilmemiz amacıyla belirli bilgileri onlarla paylaşmamızı gerektirmektedir. Devam ederek bilgilerinizi paylaşmayı ve yayıncının size e-posta göndermesine izin vermeyi kabul etmiş olursunuz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Наша угода з видавцем цього перекладу Біблії вимагає від нас поділитися з ним певною інформацією, щоб ми могли запропонувати цей переклад для використання офлайн. Продовжуючи, ви погоджуєтеся поділитися своєю інформацією та дозволити видавцю надсилати вам електронні листи."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thỏa thuận của chúng tôi với nhà xuất bản của phiên bản Kinh Thánh này yêu cầu chúng tôi chia sẻ một số thông tin nhất định với họ để cung cấp phiên bản này cho việc sử dụng ngoại tuyến. Bằng cách tiếp tục, bạn đồng ý chia sẻ thông tin của mình và cho phép nhà xuất bản gửi email cho bạn."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mae ein cytundeb â chyhoeddwr y fersiwn Beibl hwn yn ei gwneud yn ofynnol i ni rannu gwybodaeth benodol gyda nhw er mwyn cynnig y fersiwn hwn i'w ddefnyddio all-lein. Drwy barhau rwyt yn cytuno i rannu dy wybodaeth ac i ganiatáu i'r cyhoeddwr anfon e-bost atat."
          }
        }
      }
    },
    "offlineDownloadTagline" : {
      "comment" : "Promotional tagline for offline Bible download feature.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Read it anytime, anywhere—even offline"
          }
        },
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lees dit enige tyd, enige plek – selfs vanlyn"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اقرأه في أي وقت وفي أي مكان—حتى دون اتصال"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
