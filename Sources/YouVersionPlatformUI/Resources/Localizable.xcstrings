    "bibleCard.unavailableReference": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This passage is unavailable in the selected Bible version."
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Hierdie gedeelte is nie in die gekose Bybelweergawe beskikbaar nie."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا المقطع غير متوفر في إصدار الكتاب المقدس المحدد."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Nid yw'r darn hwn ar gael yn y fersiwn Beibl a ddewiswyd."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Passage ist in der ausgewählten Bibelversion nicht verfügbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este pasaje no está disponible en la versión de la Biblia seleccionada."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Este pasaje no está disponible en la versión de la Biblia seleccionada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce passage n'est pas disponible dans la version de la Bible sélectionnée."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a szakasz nem érhető el a kiválasztott Bibliafordításban."
          }
        },
        "ig": {
          "stringUnit": {
            "state": "translated",
            "value": "Akụkụ Akwụkwọ Nsọ a adịghị na ụdị-nsụgharị Akwụkwọ Nsọ ahọpụtarà."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 성경 번역본에서는 이 본문을 사용할 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta passagem não está disponível na versão da Bíblia selecionada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот отрывок недоступен в выбранном переводе Библии."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det här avsnittet finns inte i den valda bibelöversättningen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu pasaj seçilen Kutsal Kitap çeviri sürümünde mevcut değildir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đoạn văn này không có trong phiên bản Kinh Thánh đã chọn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此段落在所选圣经译本中不可用。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "此段落在所選的聖經譯本中無法提供。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此段落在所選的聖經譯本中無法使用。"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tato pasáž není dostupná ve vybrané verzi Bible."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä kohta ei ole saatavilla valitussa Raamatun versiossa."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo brano non è disponibile nella versione della Bibbia selezionata."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit gedeelte is niet beschikbaar in de geselecteerde Bijbelvertaling."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette avsnittet er ikke tilgjengelig i den valgte bibelutgaven."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovaj odlomak nije dostupan u odabranom prevodu Biblije."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей уривок недоступний у вибраному перекладі Біблії."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta passagem não está disponível na versão da Bíblia selecionada."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この聖書箇所は、選択した聖書の訳では利用できません。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acest pasaj nu este disponibil în versiunea Bibliei selectate."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_translation",
            "value": ""
          }
        }
      },
      "comment": "Error message on Bible card when passage is unavailable."
    },
    "bibleText.connectionIssue": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We’re having difficulties with your connection. Please download a Bible version when you’re online."
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Ons ondervind probleme met jou verbinding. Laai asseblief 'n Bybelweergawe af wanneer jy aanlyn is."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نواجه صعوبات في اتصالك. يرجى تنزيل إصدار من الكتاب المقدس عندما تكون متصلاً بالإنترنت."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Rydym yn cael anawsterau gyda'th gysylltiad. Lawrlwytha fersiwn o'r Beibl pan fyddi ar-lein."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir haben Probleme mit deiner Verbindung. Bitte lade eine Bibelversion herunter, wenn du online bist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estamos teniendo dificultades con tu conexión. Por favor, descarga una versión de la Biblia cuando estés en línea."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Estamos teniendo dificultades con tu conexión. Por favor descarga una versión de la Biblia cuando estés en línea."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous rencontrons des difficultés avec votre connexion. Veuillez télécharger une version de la Bible lorsque vous êtes en ligne."
          }
        },
        "ig": {
          "stringUnit": {
            "state": "translated",
            "value": "Anyị nà-ènwé nsogbu na njikọ ịntanetị gị. Biko budata ụdị-nsụgharị Akwụkwọ Nsọ mgbe ị nọ n'ịntanetị."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결에 문제가 발생했습니다. 온라인 상태일 때 성경 번역본을 다운로드하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Estamos tendo dificuldades com a conexão. Baixe uma versão da Bíblia quando estiver on-line."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У нас возникли проблемы с вашим подключением. Пожалуйста, скачайте перевод Библии, когда будете в сети."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi har problem med din anslutning. Ladda gärna ner en bibelversion när du är online."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlantınızda sorun yaşıyoruz. Lütfen çevrimiçiyken bir Kutsal Kitap versiyonu indirin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chúng tôi đang gặp sự cố với kết nối của bạn. Vui lòng tải xuống một phiên bản Kinh Thánh khi bạn trực tuyến."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的连接出现问题。请在联网时才下载圣经译本。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "我們與你的連線出現了問題。請於在線時下載聖經譯本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的連線發生問題。請在上線時才下載聖經譯本。"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Máme potíže s vaším připojením. Stáhněte si verzi Bible, když budete online."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yhteydessäsi on ongelmia. Lataa Raamatun versio, kun olet verkossa."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si sono verificati problemi con la tua connessione. Scarica una versione della Bibbia quando sei online."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "We ondervinden problemen met je verbinding. Download een Bijbelvertaling wanneer je online bent."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi har problemer med tilkoblingen. Last ned en bibelutgave når du er tilkoblet internett."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Imamo poteškoća sa vašom vezom. Preuzmite prevod Biblije kada budete na mreži."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виникли проблеми з вашим з'єднанням. Будь ласка, завантажте переклад Біблії, коли будете онлайн."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Estamos a ter dificuldades com a sua ligação. Por favor, descarregue uma versão da Bíblia quando estiver online."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続に問題が発生しています。オンラインのときに聖書の訳をダウンロードしてください。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunt ceva dificultăți cu conexiunea ta. Te rugăm să descarci o versiune a Bibliei când ești conectat."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Probléma merült fel az internetkapcsolattal. Kérjük, tölts le egy Bibliafordítást, amikor újra online vagy."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_translation",
            "value": ""
          }
        }
      },
      "comment": "Connection error message in Bible text view."
    },
    "bibleText.unavailableVersion": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your previously selected Bible version is unavailable. Please switch to another one."
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Bybelweergawe wat jy voorheen gekies het, is nie beskikbaar nie. Kies asseblief 'n ander weergawe."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إصدار الكتاب المقدس الذي حددته سابقاً غير متاح. يرجى التبديل إلى إصدار آخر."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Nid yw'r fersiwn Beibl a ddewiswyd gen ti yn flaenorol ar gael. Newidia i un arall."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine zuvor ausgewählte Bibelversion ist nicht verfügbar. Bitte wechsle zu einer anderen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La versión de la Biblia que seleccionaste anteriormente no está disponible. Por favor, cambia a otra."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "La versión de la Biblia que seleccionaste anteriormente no está disponible. Por favor cambia a otra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La version de la Bible précédemment sélectionnée n'est pas disponible. Veuillez en choisir une autre."
          }
        },
        "ig": {
          "stringUnit": {
            "state": "translated",
            "value": "Ụdị nsụgharị Akwụkwọ Nsọ ị họpụtarà na mbụ adịghị adị. Biko gbanwee gaa na ọzọ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이전에 선택한 성경 번역본을 사용할 수 없습니다. 다른 번역본을 선택해 주세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A versão da Bíblia selecionada anteriormente não está disponível. Mude para outra."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ранее выбранный перевод Библии недоступен. Пожалуйста, переключитесь на другой."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den bibelöversättning du tidigare valt är inte tillgänglig. Byt till en annan."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Daha önce seçtiğiniz Kutsal Kitap çeviri versiyonu kullanılamıyor. Lütfen başka bir versiyona geçin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phiên bản Kinh Thánh bạn đã chọn trước đó không khả dụng. Vui lòng chuyển sang phiên bản khác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你之前选择的圣经译本不可用。请切换到其他译本。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "你先前選擇的聖經譯本無法使用。請切換至其他譯本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你先前選擇的聖經譯本無法使用。請切換至其他譯本。"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dříve vybraná verze Bible není dostupná. Přepněte prosím na jinou."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aiemmin valitsemasi Raamatun versio ei ole saatavilla. Vaihda toiseen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La versione della Bibbia precedentemente selezionata non è disponibile. Passa a un'altra versione."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De Bijbelvertaling die je eerder had gekozen, is niet beschikbaar. Kies alsjeblieft een andere."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den tidligere valgte bibelutgaven er ikke tilgjengelig. Bytt til en annen."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Prethodno odabran prevod Biblije nije dostupan. Molimo, izaberite drugi prevod."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Раніше вибраний переклад Біблії недоступний. Будь ласка, перейдіть на інший."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A versão da Bíblia selecionada anteriormente não está disponível. Por favor, mude para outra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "以前に選択した聖書の訳は利用できません。別の訳に切り替えてください。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Versiunea Bibliei selectată anterior nu este disponibilă. Te rugăm să alegi o altă versiune."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A korábban kiválasztott Bibliafordítás nem érhető el. Kérjük, válts egy másikra."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_translation",
            "value": ""
          }
        }
      },
      "comment": "Message shown when the user's selected Bible version is no longer available."
    },
