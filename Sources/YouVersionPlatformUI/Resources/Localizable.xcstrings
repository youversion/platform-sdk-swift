        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deberás iniciar sesión nuevamente para acceder a tus destacados."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Újra be kell jelentkezned a kiemeléseid eléréséhez."
          }
        },
        "ig": {
          "stringUnit": {
            "state": "translated",
            "value": "Ọ dị mkpa ka ị bànyé ọzọ iji nweta ihe gị ndị ị merè ka ha pụta ìhè."
