    "signOut.question": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bist du sicher, dass du dich bei YouVersion abmelden möchtest?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Are you sure you want to sign out from YouVersion?"
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Estás seguro de que quieres cerrar sesión en YouVersion?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Êtes-vous sûr de vouloir vous déconnecter de YouVersion ?"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Is jy seker jy wil jou intekening by YouVersion beëindig?"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل أنت متأكد أنك تريد تسجيل الخروج من YouVersion؟"
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyt ti'n siŵr dy fod am allgofnodi o YouVersion?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Estás seguro de que quieres cerrar sesión en YouVersion?"
          }
        },
        "ig": {
          "stringUnit": {
            "state": "translated",
            "value": "Ị̀ jì n'aka na ị chọrọ isi na YouVersion pụọ?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "YouVersion에서 로그아웃하시겠습니까?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tem certeza de que deseja sair da YouVersion?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы уверены, что хотите выйти из YouVersion?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Är du säker på att du vill logga ut från YouVersion?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "YouVersion'dan çıkış yapmak istediğinizden emin misiniz?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có chắc muốn đăng xuất khỏi YouVersion không?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你确定要退出 YouVersion 吗？"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "你確定要從 YouVersion 登出嗎？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你確定要登出 YouVersion 嗎？"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Opravdu se chcete odhlásit z YouVersion?"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Haluatko varmasti kirjautua ulos YouVersionista?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sei sicuro di voler uscire da YouVersion?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Weet je zeker dat je je wilt afmelden bij YouVersion?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Er du sikker på at du vil logge ut fra YouVersion?"
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Da li ste sigurni da želite da se odjavite sa YouVersion-a?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви впевнені, що хочете вийти з YouVersion?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tem certeza de que deseja terminar sessão na YouVersion?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "YouVersionからサインアウトしてもよろしいですか？"
          }
        },
        "ro": {
